# Sniffer
INTERFACE=<GAME_INTERFACE>          # Change me (e.g. eth0)
MACHINE_IP=<GAME_IP>                # Change me (e.g. 10.10.10.10)

# Broker
NATS_HOST=nats:4222
NATS_LOGIN=red-eye-client
NATS_PASSWORD=<PASSWORD>            # Change me — enforced by the NATS server (nats.conf), used by all clients
NATS_UPDATES_TOPIC=updates
NATS_WS_TOPIC=websocket_packets
NATS_RAW_PACKETS_TOPIC=raw_packets

# Database
DB_HOST=db
DB_PORT=5432
DB_USERNAME=red-eye-user
DB_PASSWORD=<PASSWORD>              # Change me
DB_SCHEMA=red-eye

# Backend
WEB_IP=0.0.0.0
WEB_PORT=8000
WEB_PASSWORD=<PASSWORD>             # Change me
# Session cookie key — required, change me: openssl rand -base64 32
COOKIE_KEY=<generate: openssl rand -base64 32>

# --- Monitoring (optional) ---
# Grafana admin password — only needed when running the monitoring profile
GRAFANA_ADMIN_PASSWORD=<PASSWORD>   # Change me (monitoring profile only)

# --- Cleanup Configuration ---
# Small game (<=10 teams):  AGE=30, INTERVAL=5, DISK=60000
# Medium game (<=30 teams): AGE=15, INTERVAL=2, DISK=40000
# Large game (100+ teams):  AGE=10, INTERVAL=1, DISK=30000
CLEANUP_STREAM_AGE_MINUTES=15
CLEANUP_INTERVAL_MINUTES=2
CLEANUP_MAX_DISK_MB=40000

# --- Traffic Analyzer Tuning ---
# Cache: how long stream ID mappings stay in memory
CACHE_STREAM_TTL_SECS=120
CACHE_EVICTION_INTERVAL_SECS=30

# Batch insert: packets are buffered and flushed together
BATCH_SIZE=500
BATCH_FLUSH_INTERVAL_MS=100

# Max concurrent packet processing tasks (semaphore limit)
ANALYZER_CONCURRENCY=256

# --- Health Monitoring ---
# P95 query latency thresholds (ms) for circuit breaker
HEALTH_QUERY_WARN_MS=3000
HEALTH_QUERY_CRITICAL_MS=8000
HEALTH_KILL_QUERY_AFTER_MS=30000

# --- Frontend ---
MAX_SELECTED_STREAMS=10

# Logging
# info is the default. debug writes ~3 log lines per packet (~100 GB/hour
# under game load) and can fill the disk — enable only for short troubleshooting.
LOGGING_LEVEL=info