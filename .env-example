# Sniffer
INTERFACE=<GAME_INTERFACE>          # Change me (e.g. eth0)
MACHINE_IP=<GAME_IP>                # Change me (e.g. 10.10.10.10)

# Broker
NATS_HOST=nats:4222
NATS_LOGIN=red-eye-client
NATS_PASSWORD=<PASSWORD>            # Change me
NATS_UPDATES_TOPIC=updates
NATS_WS_TOPIC=websocket_packets
NATS_RAW_PACKETS_TOPIC=raw_packets

# Database
DB_HOST=db
DB_PORT=5432
DB_USERNAME=red-eye-user
DB_PASSWORD=<PASSWORD>              # Change me
DB_SCHEMA=red-eye

# Backend
WEB_IP=0.0.0.0
WEB_PORT=8000
WEB_PASSWORD=<PASSWORD>             # Change me

# --- Cleanup Configuration ---
# Small game (<=10 teams):  AGE=30, INTERVAL=5, DISK=60000
# Medium game (<=30 teams): AGE=15, INTERVAL=2, DISK=40000
# Large game (100+ teams):  AGE=10, INTERVAL=1, DISK=30000
CLEANUP_STREAM_AGE_MINUTES=15
CLEANUP_INTERVAL_MINUTES=2
CLEANUP_MAX_DISK_MB=40000

# Logging
LOGGING_LEVEL=debug