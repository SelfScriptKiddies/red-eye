{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "noEmit": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "useDefineForClassFields": true
    },
    "include": [
      "src/**/*",
    ],
    "exclude": [
        "src/main.tsx",
        "src/setupProxy.js"
    ]
  }
